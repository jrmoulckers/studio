{
  "nav": {
    "$description": "Consistent chrome — the shell never changes game to game.",
    "tabbar": {
      "bg": {
        "$value": "{semantic.background.elevated}",
        "$type": "color",
        "$description": "Consumers may layer glass (backdrop-filter: blur(12px)) + alpha per the Glass-Chrome Rule."
      },
      "border": { "$value": "{semantic.border.default}", "$type": "color" },
      "radius": { "$value": "{radius.md}", "$type": "dimension" }
    },
    "tab": {
      "text": { "$value": "{semantic.text.secondary}", "$type": "color" },
      "active-text": { "$value": "{semantic.text.primary}", "$type": "color" },
      "active-bg": { "$value": "{semantic.background.secondary}", "$type": "color" },
      "radius": { "$value": "{radius.chip}", "$type": "dimension" }
    },
    "iconbtn": {
      "bg": { "$value": "{semantic.background.secondary}", "$type": "color" },
      "text": { "$value": "{semantic.text.primary}", "$type": "color" },
      "size": { "$value": "{target.min}", "$type": "dimension" },
      "radius": { "$value": "{radius.chip}", "$type": "dimension" }
    }
  }
}
