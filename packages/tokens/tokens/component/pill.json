{
  "pill": {
    "$description": "Compact status/meta token — never a button.",
    "bg": { "$value": "{semantic.background.secondary}", "$type": "color" },
    "text": { "$value": "{semantic.text.secondary}", "$type": "color" },
    "border": { "$value": "{semantic.border.default}", "$type": "color" },
    "radius": { "$value": "{radius.pill}", "$type": "dimension" },
    "padding-x": { "$value": "{spacing.sm}", "$type": "dimension" },
    "padding-y": { "$value": "3px", "$type": "dimension" }
  }
}
