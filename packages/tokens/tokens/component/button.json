{
  "button": {
    "$description": "One shape language (9px controls, >=46px targets), one state model.",
    "primary": {
      "bg": { "$value": "{semantic.interactive.default}", "$type": "color" },
      "text": { "$value": "{semantic.text.inverse}", "$type": "color" },
      "border": { "$value": "{semantic.interactive.hover}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.interactive.hover}", "$type": "color" },
      "radius": { "$value": "{radius.sm}", "$type": "dimension" },
      "min-height": { "$value": "{target.min}", "$type": "dimension" },
      "padding-x": { "$value": "18px", "$type": "dimension" },
      "padding-y": { "$value": "12px", "$type": "dimension" }
    },
    "default": {
      "bg": { "$value": "{semantic.background.secondary}", "$type": "color" },
      "text": { "$value": "{semantic.text.primary}", "$type": "color" },
      "border": { "$value": "{semantic.border.default}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.background.raised}", "$type": "color" },
      "radius": { "$value": "{radius.sm}", "$type": "dimension" },
      "min-height": { "$value": "{target.min}", "$type": "dimension" },
      "padding-x": { "$value": "18px", "$type": "dimension" },
      "padding-y": { "$value": "12px", "$type": "dimension" }
    },
    "ghost": {
      "bg": { "$value": "transparent", "$type": "color" },
      "text": { "$value": "{semantic.text.primary}", "$type": "color" }
    },
    "danger": {
      "bg": { "$value": "transparent", "$type": "color" },
      "text": { "$value": "{semantic.status.negative}", "$type": "color" },
      "border": { "$value": "{semantic.status.negative}", "$type": "color" }
    }
  }
}
