{
  "font": {
    "family": {
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$type": "fontFamily",
        "$description": "One native sans for everything — the Quiet-Type Rule."
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      }
    },
    "size": {
      "display": {
        "$value": "1.6rem",
        "$type": "dimension"
      },
      "title": {
        "$value": "1.25rem",
        "$type": "dimension"
      },
      "body": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "label": {
        "$value": "0.9rem",
        "$type": "dimension"
      },
      "overline": {
        "$value": "0.8rem",
        "$type": "dimension"
      }
    },
    "lineHeight": {
      "tight": {
        "$value": 1.2,
        "$type": "number"
      },
      "snug": {
        "$value": 1.4,
        "$type": "number"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number"
      },
      "relaxed": {
        "$value": 1.75,
        "$type": "number",
        "$description": "Roomy leading — used by cognitive-accessibility mode for improved reading flow."
      }
    },
    "letterSpacing": {
      "normal": {
        "$value": "0",
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.08em",
        "$type": "dimension",
        "$description": "Overline tracking"
      }
    },
    "variantNumeric": {
      "$description": "Numeric figure styles. Proportional digits are correct for prose; columns of numbers that a reader compares vertically need tabular figures, or the digits fail to line up and scanning breaks down.",
      "normal": {
        "$value": "normal",
        "$type": "fontVariantNumeric",
        "$description": "Proportional figures — the default, correct inside running text."
      },
      "tabular": {
        "$value": "tabular-nums",
        "$type": "fontVariantNumeric",
        "$description": "Fixed-width figures so digits align vertically in scores, amounts, and tables."
      },
      "tabular-slashed": {
        "$value": "tabular-nums slashed-zero",
        "$type": "fontVariantNumeric",
        "$description": "Tabular figures with a slashed zero, which separates 0 from O in reference codes and account numbers."
      }
    }
  }
}
