      "weight": { "$value": "{font.weight.bold}", "$type": "fontWeight" },
      "line-height": { "$value": "{font.lineHeight.tight}", "$type": "number" }
    },
    "body": {
      "family": { "$value": "{font.family.sans}", "$type": "fontFamily" },
