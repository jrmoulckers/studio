{
  "$description": "score-king DARK semantic palette — the canonical mode (the app boots data-theme=\"dark\"). Emitted under [data-theme=\"dark\"].",
  "color": {
    "bg": { "$value": "{color.ink.midnight}", "$type": "color" },
    "surface": { "$value": "{color.ink.indigo-slate}", "$type": "color" },
    "surface-2": { "$value": "{color.ink.raised-slate}", "$type": "color" },
    "surface-3": { "$value": "{color.ink.lifted-slate}", "$type": "color" },
    "border": { "$value": "{color.ink.court-line}", "$type": "color" },
    "text": { "$value": "{color.ink.moonlight}", "$type": "color" },
    "text-muted": { "$value": "{color.ink.lavender-gray}", "$type": "color" },
    "primary": { "$value": "{color.royal-violet.500}", "$type": "color" },
    "primary-strong": { "$value": "{color.royal-violet.600}", "$type": "color" },
    "on-primary": { "$value": "{color.base.white}", "$type": "color" },
    "accent": { "$value": "{color.crown-gold.500}", "$type": "color" },
    "accent-ink": { "$value": "{color.crown-gold.500}", "$type": "color", "$description": "Gold text on dark surfaces keeps pure Crown Gold." },
    "success": { "$value": "{color.win.500}", "$type": "color" },
    "danger": { "$value": "{color.loss.500}", "$type": "color" },
    "warning": { "$value": "{color.caution.500}", "$type": "color" },
    "focus-ring": { "$value": "{color.royal-violet.500}", "$type": "color" }
  },
  "shadow": {
    "lift": { "$value": "{shadow.soft-lift-dark}", "$type": "shadow" },
    "hairline": { "$value": "{shadow.inset-hairline}", "$type": "shadow" }
  }
}
