{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrmoulckers/studio/blob/main/principles/migration-ledger.schema.json",
  "title": "JRM Studio legacy principle migration ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "entries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "realmFiles", "topLevelPrinciples", "idFormat"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "realmFiles": {
          "const": 21
        },
        "topLevelPrinciples": {
          "const": 192
        },
        "idFormat": {
          "const": "studio-legacy:<realm-file-slug>:<top-level-number>"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id"],
      "properties": {
        "authority": {
          "enum": ["Studio", "Engineering", "Product", ".github"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyId", "disposition", "successors", "status", "evidence", "owner"],
      "properties": {
        "legacyId": {
          "type": "string",
          "pattern": "^studio-legacy:[a-z0-9]+(?:-[a-z0-9]+)*:[1-9][0-9]*$"
        },
        "disposition": {
          "enum": ["rewrite", "split", "reference", "retire"]
        },
        "successors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/successor"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": ["proposed", "ratified", "implemented", "verified"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": ["rewrite", "reference"]
              }
            }
          },
          "then": {
            "properties": {
              "successors": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "split"
              }
            }
          },
          "then": {
            "properties": {
              "successors": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "retire"
              }
            }
          },
          "then": {
            "properties": {
              "successors": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
