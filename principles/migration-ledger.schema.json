{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrmoulckers/studio/blob/main/principles/migration-ledger.schema.json",
  "title": "JRM Studio legacy principle migration ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "entries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "realmFiles", "topLevelPrinciples", "idFormat"],
      "properties": {
        "repository": {
          "const": "https://github.com/jrmoulckers/studio"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "realmFiles": {
          "const": 21
        },
        "topLevelPrinciples": {
          "const": 192
        },
        "idFormat": {
          "const": "studio-legacy:<realm-file-slug>:<top-level-number>"
        }
      }
    },
    "entries": {
      "type": "object",
      "minProperties": 192,
      "maxProperties": 192,
      "propertyNames": {
        "$ref": "#/$defs/legacyId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "legacyId": {
      "type": "string",
      "pattern": "^studio-legacy:(?:accessibility:[1-7]|ai-process:(?:[1-9]|1[0-9]|2[0-2])|ai-products:[1-8]|architecture:(?:[1-9]|1[0-5])|backend:[1-7]|business:[1-6]|compliance:[1-8]|data-analytics:[1-7]|design:(?:[1-9]|1[0-3])|devops:(?:[1-9]|1[0-5])|documentation:[1-7]|featuring:[1-7]|frontend:[1-9]|local-first:[1-4]|localization:[1-9]|middleware:[1-7]|performance:[1-9]|process:[1-7]|project-planning:[1-7]|security:[1-8]|testing:(?:[1-9]|10))$"
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id"],
      "properties": {
        "authority": {
          "enum": ["Studio", "Engineering", "Product", ".github"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citationException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "evidence"],
      "properties": {
        "kind": {
          "const": "externally-verified-ownership"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "successors", "status", "rationale", "evidence", "owner"],
      "properties": {
        "disposition": {
          "enum": ["rewrite", "split", "reference", "retire"]
        },
        "successors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/successor"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": ["proposed", "ratified", "implemented", "verified"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "retirementCategory": {
          "enum": [
            "duplicated",
            "incident-specific",
            "operational-convention",
            "operational-housekeeping",
            "over-specific-mechanism",
            "unsupported-proposal"
          ]
        },
        "citationException": {
          "$ref": "#/$defs/citationException"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": ["rewrite", "reference"]
              }
            }
          },
          "then": {
            "properties": {
              "successors": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "split"
              }
            }
          },
          "then": {
            "properties": {
              "successors": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "retire"
              }
            }
          },
          "then": {
            "required": ["retirementCategory"],
            "properties": {
              "successors": {
                "type": "array",
                "maxItems": 0
              }
            },
            "not": {
              "required": ["citationException"]
            }
          },
          "else": {
            "not": {
              "required": ["retirementCategory"]
            }
          }
        },
        {
          "if": {
            "required": ["citationException"]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "reference"
              },
              "successors": {
                "items": {
                  "properties": {
                    "authority": {
                      "enum": ["Engineering", "Product", ".github"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
