{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrmoulckers/studio/blob/main/principles/migration-verification-receipt.schema.json",
  "title": "JRM Studio principle migration verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "verifiedAt",
    "purpose",
    "claims",
    "verification",
    "refresh",
    "legacyCatalogBaseline",
    "legacySourceSnapshot",
    "authorities",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "const": "./migration-verification-receipt.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "receiptType": {
      "const": "dated-verification-evidence"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normativeSource", "provesRatification", "authorizesLegacyDeletion"],
      "properties": {
        "normativeSource": {
          "const": false
        },
        "provesRatification": {
          "const": false
        },
        "authorizesLegacyDeletion": {
          "const": false
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "retrieval", "digestMethod", "ledgerWasNotInput", "liveCommand"],
      "properties": {
        "sourceKind": {
          "const": "pinned-authority-bytes"
        },
        "retrieval": {
          "type": "string",
          "minLength": 1
        },
        "digestMethod": {
          "type": "string",
          "minLength": 1
        },
        "ledgerWasNotInput": {
          "const": true
        },
        "liveCommand": {
          "const": "pnpm principles:verify-live"
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredWhen", "procedure", "offlineLimit"],
      "properties": {
        "requiredWhen": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "offlineLimit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legacyCatalogBaseline": {
      "$ref": "#/$defs/legacyCatalog"
    },
    "legacySourceSnapshot": {
      "$ref": "#/$defs/legacySnapshot"
    },
    "authorities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/authority"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "legacyId": {
      "type": "string",
      "pattern": "^studio-legacy:[a-z0-9-]+:[1-9][0-9]*$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^principles/.+\\.md$"
    },
    "legacyCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "realmFiles", "topLevelPrinciples", "ids"],
      "properties": {
        "repository": {
          "const": "jrmoulckers/studio"
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "realmFiles": {
          "const": 21
        },
        "topLevelPrinciples": {
          "const": 192
        },
        "ids": {
          "type": "array",
          "minItems": 192,
          "maxItems": 192,
          "items": {
            "$ref": "#/$defs/legacyId"
          },
          "uniqueItems": true
        }
      }
    },
    "legacySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "realmFiles", "topLevelPrinciples", "files"],
      "properties": {
        "repository": {
          "const": "jrmoulckers/studio"
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "realmFiles": {
          "const": 21
        },
        "topLevelPrinciples": {
          "const": 192
        },
        "files": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "$ref": "#/$defs/legacyFile"
          }
        }
      }
    },
    "legacyFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blobSha", "sha256", "topLevelIds"],
      "properties": {
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "blobSha": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "topLevelIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/legacyId"
          },
          "uniqueItems": true
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "repository",
        "commit",
        "principleCount",
        "draftCount",
        "files",
        "principles",
        "catalogSha256"
      ],
      "properties": {
        "authority": {
          "enum": ["Studio", "Engineering", "Product", ".github"]
        },
        "repository": {
          "type": "string",
          "pattern": "^jrmoulckers/(?:studio|engineering|product|\\.github)$"
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "principleCount": {
          "type": "integer",
          "minimum": 1
        },
        "draftCount": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityFile"
          }
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/principle"
          }
        },
        "catalogSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorityFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blobSha", "sha256", "principleCount"],
      "properties": {
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "blobSha": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "principleCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "status",
        "legacyInputs",
        "blobSha",
        "fileSha256",
        "blockSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:STUDIO|ENG|PROD|GH)-[A-Z0-9]+-[0-9]{3}$"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "Draft"
        },
        "legacyInputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacyId"
          },
          "uniqueItems": true
        },
        "blobSha": {
          "$ref": "#/$defs/sha1"
        },
        "fileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "blockSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
