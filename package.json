{
  "name": "@jrm/studio",
  "version": "0.0.0",
  "private": true,
  "description": "JRM Studio design + tooling kernel — shared @jrm/* packages consumed across every product repo.",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && pnpm run principles:check && pnpm run workflows:check && pnpm run prettier-ignore:check && pnpm run text:check && pnpm run dist-ext:check",
    "principles:check": "node scripts/validate-principles.mjs",
    "workflows:check": "node scripts/validate-workflows.mjs",
    "principles:verify-live": "node scripts/validate-principles.mjs --live",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tokens:dist": "pnpm --filter @jrm/tokens dist",
    "tokens:dist:check": "pnpm --filter @jrm/tokens dist && git diff --exit-code -- packages/tokens/dist",
    "tokens:diff": "node scripts/token-diff.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prettier-ignore:check": "node scripts/validate-prettier-ignore.mjs",
    "text:check": "node scripts/validate-text-classification.mjs",
    "dist-ext:check": "node scripts/validate-dist-extensions.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@jrm/eslint-config": "workspace:*",
    "@jrm/prettier-config": "workspace:*",
    "@jrm/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
