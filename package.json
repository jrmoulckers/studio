{
  "name": "@jrm/studio",
  "version": "0.0.0",
  "private": true,
  "description": "JRM Studio design + tooling kernel — shared @jrm/* packages consumed across every product repo.",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && pnpm run principles:check",
    "principles:check": "node scripts/validate-principles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tokens:dist": "pnpm --filter @jrm/tokens dist",
    "tokens:dist:check": "pnpm --filter @jrm/tokens dist && git diff --exit-code -- packages/tokens/dist",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@jrm/eslint-config": "workspace:*",
    "@jrm/prettier-config": "workspace:*",
    "@jrm/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
